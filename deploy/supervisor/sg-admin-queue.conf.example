[program:sg-admin-queue]
; Ganti path dan user berikut sesuai server sebelum memasang file ini.
directory=/PATH/KE/SG-ADMIN
command=/PATH/KE/PHP /PATH/KE/SG-ADMIN/artisan queue:work database --sleep=3 --tries=3 --timeout=60
user=USER_APLIKASI
autostart=true
autorestart=true
startsecs=5
stopasgroup=true
killasgroup=true
stopwaitsecs=75
redirect_stderr=true
stdout_logfile=/PATH/KE/SG-ADMIN/storage/logs/queue-worker.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
