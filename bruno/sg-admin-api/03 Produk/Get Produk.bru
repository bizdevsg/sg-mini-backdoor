meta {
  name: Get Produk
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/produk/:section/:slug
  body: none
  auth: inherit
}

params:path {
  section: spa
  slug: contoh-slug-produk
}

docs {
  Mengambil detail produk berdasarkan section (`spa`, `jfx`, atau `prime`) dan slug. Respons menyediakan deskripsi bilingual melalui `deskripsi_produk_id` dan `deskripsi_produk_en`.
}
