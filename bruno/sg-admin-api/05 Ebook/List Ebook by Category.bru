meta {
  name: List Ebook by Category
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/ebook/categories/:slug
  body: none
  auth: inherit
}

params:path {
  slug: contoh-slug-kategori
}

params:query {
  ~search:
  ~page: 1
  ~per_page: 20
}

docs {
  Daftar ebook dalam kategori tertentu. `per_page` dibatasi 1 sampai 100.
}
