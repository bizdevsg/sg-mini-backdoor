meta {
  name: Get Berita
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/berita/:slug
  body: none
  auth: inherit
}

params:path {
  slug: trump-redakan-kekhawatiran-konflik-iran
}

docs {
  Mengambil detail berita berdasarkan slug.

  Menyertakan `is_breaking_news` (true hanya selama aktif, 1 jam) dan `breaking_news_expires_at` (ISO8601 atau null).
}
