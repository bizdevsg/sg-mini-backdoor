meta {
  name: List Produk
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/produk/:section
  body: none
  auth: inherit
}

params:path {
  section: spa
}

params:query {
  ~search:
  ~page: 1
  ~per_page: 20
}

docs {
  Daftar produk. Nilai `section` yang valid adalah `spa`, `jfx`, atau `prime`; `per_page` dibatasi 1 sampai 100. Respons menyediakan `deskripsi_produk_id` dan `deskripsi_produk_en`, sementara `deskripsi_produk` tetap menjadi alias Bahasa Indonesia untuk kompatibilitas.
}
